/*
 * -------------------------------------------------
 *  RTBioSAcan Nextflow config file
 * -------------------------------------------------
 * Default config options for all environments.
 */

// Global default params, used in configs.
params {

  // Identity and execution mode
  outdir = "$launchDir/results"
  run_id = ""
  state_id = ""
  run_mode = "realtime"
  watch = true
  restart_mode = "off"
  restart_force = false
  state_compatibility_policy = "strict" // allowed: strict, adopt_legacy
  state_reference_manifest = "conf/state_compatibility/reference_manifest_legacy_v1.tsv"
  state_taxonomy_data_dir = "db/taxonomy/releases/ncbi-taxdump-2024-06-24"
  state_taxonomy_release_manifest = "conf/state_compatibility/taxonomy_release_ncbi_2024-06-24.tsv"
  state_reference_verification = "cached" // allowed: cached, full
  state_verification_cache_dir = "" // empty derives <outdir>/temp/_compatibility_cache
  state_classifier_policy_version = "legacy-rank-string-v1"
  state_scoring_policy_version = "legacy-first-single-hit-v1"
  state_toolchain_policy_manifest = "conf/runtime_compatibility/toolchain_legacy_v1.tsv"
  state_runtime_lock_manifest = "auto" // activated Conda: select the committed platform lock
  state_dorado_release_manifest = "" // optional qualified-release manifest
  state_contract_migration = "strict" // allowed: strict, attest_v1
  replicate_mode = "track"
  monochrome_logs = false
  hostnames = [:]

  // Input and demultiplexing
  reads = "$launchDir/results/pod5/reads_rt_round_pod5/*pod5"
  ori_dir = "$launchDir/results/pod5/ori_round_pod5/"
  indexes = "$launchDir/results/sample_info/demult.fasta"
  primer_indexes = "$launchDir/results/sample_info/primers.fasta"
  demultiplex_mode = "auto" // allowed: auto, full, primers_only, off

  // Marker schema (pipe-separated, same order as `targets`)
  targets = "COI|ITS2"
  // Leave an entry empty (e.g. "Metazoa|") to accept any taxon for that marker.
  target_taxa = "Metazoa|Viridiplantae"
  min_read_lengths = "350|286"
  max_read_lengths = "532|360"
  fast_filter_shadow = false // diagnostic only; never changes FAST retention

  // Basecalling and quality
  on_target_quality_score = 0
  min_quality_score = 10
  hq_quality_score = 15
  dorado_device = "metal"
  dorado_bin = "bin/dorado/bin/dorado"
  dorado_input_mode = "file" // allowed: file, directory (legacy Dorado 0.2.x)
  dorado_summary_bin = "" // empty uses dorado_bin
  dorado_retry_attempts = 3
  dorado_retry_sleep_seconds = 10
  fast_chunksize = 1000
  fast_batchsize = 5040
  fast_overlap = 100
  fast_model = "bin/dorado/bin/dna_r10.4.1_e8.2_400bps_fast@v5.0.0"
  hac_chunksize = 2000
  hac_batchsize = 3024
  hac_overlap = 500
  hac_model = "bin/dorado/bin/dna_r10.4.1_e8.2_400bps_hac@v5.0.0"
  sup_chunksize = 5000
  sup_batchsize = 720
  sup_overlap = 1000
  sup_model = "bin/dorado/bin/dna_r10.4.1_e8.2_400bps_sup@v4.3.0"

  // Databases and taxonomy
  blast_filter_db = "db/targets_All_tagged_nr95"
  blast_db_specs = "db/COInr98_2024Jun_RioNegro_Brazil|db/ITS2nr98_2024Jun_RioNegro_Brazil"
  blast_taxdb = "db/taxdb"
  blast_evalue = 11
  blast_max_hsps = 50
  blast_id_family = "92|92"
  blast_id_genus = "95|95"
  blast_id_spec = "98|98"
  nonncbi_memtax = "db/COInr_2024Jun_metazoa_memtax1.txt|db/ITS2nr_2024Jun_viridiplantae_memtax2.txt"
  nonncbi_id2lineage_target = "db/DBnr_2024Jun_id2lineage.txt"
  metazoa_spc_basics = ""
  viridiplantae_spc_basics = ""
  local_metazoa_gns = ""
  local_viridiplantae_gns = ""
  min_reads_sample = 3

  // OTU and consensus
  otu_id = 97
  assign_protection_level = "genus"
  otu_frozen_enabled = true
  otu_frozen_min_rounds = 3
  otu_frozen_min_reads = 50
  otu_frozen_growth_window = 3
  otu_frozen_drop_ratio = 0.25
  otu_frozen_min_frac = 0.0
  otu_incremental_min_new = 1
  otu_hashmap_mixed_policy = "pipe_only"
  otu_allow_unsafe_recovery = false
  otu_strict_ids = true
  otu_commit_dropped_hashes = false
  otu_pool_decision_include_hash = false
  otu_frozen_db_only_policy = "auto"
  otu_pruned_recovery_enabled = false
  // otu_pruned_recovery_identity: derived at runtime from otu_id (see main.nf validateOtuRecoveryPruneParams)
  otu_pruned_recovery_target_policy = "same_target_only"
  otu_pruned_recovery_failure_policy = "warn_skip"
  prune_unassigned_clusters = false
  prune_unassigned_drop_reads = false
  prune_unassigned_grace_rounds = 3
  prune_unassigned_keep_top = 5
  otu_prune_frozen_policy = "until_consolidated"
  otu_prune_samples_file = ""
  otu_lock_force_prune_max_fasta_mb = 0
  otu_force_prune_override = false
  otu_consolidated_keys_mixed_policy = "sample_scoped_only"
  consensus_id = 99
  consensus_min_reads = 5
  consensus_max_reads = 15
  consensus_min_qscore = 15
  consensus_consolidated_min_qscore = 20
  consensus_reads_mode = "representative"
  consensus_max_N = 4
  consensus_keep_original_reads = false
  consensus_selector_ranking = "qscore_first"
  consensus_enforce_max_reads = false
  consensus_zero_emit_policy = "warn"
  consensus_id_mismatch_policy = "warn"
  consensus_cache_below_min_policy = "keep"
  consensus_cpu_budget = 0
  consensus_workers = 0
  otu_consolidation_lock = true
  otu_consolidation_mode = "lock"
  otu_lock_small_cluster_ratio = 0.1
  otu_lock_min_consolidated_reads = 10
  otu_lock_min_stable_rounds = 1
  otu_lock_revalidate_every_rounds = 0
  otu_sig_min_cluster_reads = 10
  // otu_sig_min_cluster_qscore: derived at runtime from consensus_consolidated_min_qscore (see main.nf validateOtuClusterLockParams)
  otu_sig_rule = "fraction"
  otu_sig_min_pool_fraction = 0.10
  otu_sig_min_top_fraction = 0.20
  otu_sig_top2_min_ratio = 2.0
  otu_sig_top2_min_delta_reads = 5
  otu_sig_min_stable_rounds = 2
  otu_lock_reset_keys = ""
  otu_size_streak_mode = "enforce"
  otu_size_streak_min_rounds = 3
  otu_blast_min_members = 3
  otu_blast_filter_mode = "enforce"
  otu_blast_force_use_filtered = true
  otu_blast_filter_skip_rounds = "3"
  otu_blast_unassigned_grace_rounds = 3
  otu_blast_enforce_missing_max_frac = 0.1
  otu_blast_enforce_no_clusters_policy = "fallback_unfiltered"
  otu_blast_unassigned_mode = "enforce"
  otu_blast_unassigned_max_otu_size = 50
  otu_unassigned_streak_mode = "enforce"
  otu_unassigned_streak_min_rounds = 3
  otu_unassigned_streak_min_size = 2
  otu_unassigned_streak_max_size = 50

  // Reporting and retention
  html_report_enabled = true
  html_report_auto_refresh = true
  html_report_refresh_seconds = 15
  html_report_url_prefix = ""
  html_report_sample_plot_max = 10
  delete_input_pod5 = false
  delete_from_ori_dir = false
  make_round_tar = false
  prune_round_sequences = true
  prune_cumulative_pool_all = true

  // Locks and runtime timing
  file_wait_minutes = 30
  round_lock_wait_minutes = 360
  stale_lock_ttl_minutes = 360
  lock_wait_seconds = 300
  round_lock_scope = "full_round"

  // Concurrency and resources
  maxforks_fast = 1
  maxforks_reporting = 2
  maxforks_consensus = 1
  maxforks_stateful_core = 1
  align_threads = 8
  blast_threads = 8
  cluster_threads = 8
  max_memory = 32.GB
  max_cpus = 16
  max_time = 240.h

}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

// Shared bash helpers sourced into every process (keeps retry logic consistent across processes).
// In Nextflow 22.10.x `beforeScript` runs in the wrapper shell, while `.command.sh` is executed as a
// new bash process. Export the function so it is available in the child shell too.
//
// Also set a global Dorado lock path to prevent overlapping basecaller invocations (Metal/GPU overload).
// Quote the path so projects under folders with spaces still work.
// Use params.outdir for the global Dorado lock so all tasks can coordinate through
// the same writable runtime directory.
def rtbioscanBeforeScript = """source ${projectDir}/bin/lib/retry.sh
export -f dorado_basecall_retry
export DORADO_LOCK_PATH="${params.outdir}/temp/ongoing/_dorado_basecaller"
export DORADO_RETRY_ATTEMPTS="${params.dorado_retry_attempts}"
export DORADO_RETRY_SLEEP_SECONDS="${params.dorado_retry_sleep_seconds}"
"""
process.beforeScript = rtbioscanBeforeScript

// Serialize stateful round-level BLAST to ensure assigned-OTU keys are available
// before the next round enters BLAST filtering.
process {
  withName: blast_OTU_pretax {
    maxForks = 1
  }
}

profiles {
  conda {
    // Intentionally retained as an explanatory stub. Install and activate the
    // platform lock, then run without -profile conda; direct Nextflow Conda
    // resolution would not consume the committed conda-lock solution.
    params.unsupported_execution_profile = 'conda'
  }
  // Use single-quoted string for the debug suffix to avoid Groovy `$...` interpolation surprises.
  debug { process.beforeScript = rtbioscanBeforeScript + '\necho $HOSTNAME' }
  docker {
    // Intentionally retained as an explanatory stub. main.nf rejects this profile
    // because RTBioScan does not yet publish a validated container image.
    params.unsupported_execution_profile = 'docker'
  }
  singularity {
    // Intentionally retained as an explanatory stub. main.nf rejects this profile
    // because RTBioScan does not yet publish a validated container image.
    params.unsupported_execution_profile = 'singularity'
  }
  xprize    { includeConfig 'conf/xprize.config' }
  test      { includeConfig 'conf/test.config' }
  barcoding { includeConfig 'conf/barcoding.config' }
  voucher   { includeConfig 'conf/voucher.config' }
}

// Keep task Python imports independent from user-site packages.
env {
  PYTHONNOUSERSITE = 1
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

manifest {
  name = 'RTBioScan'
  author = 'David Juan, Javer Prado'
  homePage = ''
  description = 'Hierarchical real-time analysis pipeline for nanopore metagenomic data'
  mainScript = 'main.nf'
  nextflowVersion = '>=22.10.0, <23.0.0'
  version = '1.0dev'
}

// Function to ensure that resource requirements don't go beyond
// a maximum limit
def check_max(obj, type) {
  if (type == 'memory') {
    try {
      if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
        return params.max_memory as nextflow.util.MemoryUnit
      else
        return obj
    } catch (all) {
      println "   ### ERROR ###   Max memory '${params.max_memory}' is not valid! Using default value: $obj"
      return obj
    }
  } else if (type == 'time') {
    try {
      if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
        return params.max_time as nextflow.util.Duration
      else
        return obj
    } catch (all) {
      println "   ### ERROR ###   Max time '${params.max_time}' is not valid! Using default value: $obj"
      return obj
    }
  } else if (type == 'cpus') {
    try {
      return Math.min( obj, params.max_cpus as int )
    } catch (all) {
      println "   ### ERROR ###   Max cpus '${params.max_cpus}' is not valid! Using default value: $obj"
      return obj
    }
  }
}
