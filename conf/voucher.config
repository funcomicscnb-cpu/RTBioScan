params {
  // Voucher runs should fail fast if demultiplexing inputs are missing.
  demultiplex_mode = "full"

  // Tight OTU definition for dominant single-individual samples.
  otu_id = 99

  // Make consensus more selective and less sensitive to tiny side clusters.
  consensus_min_reads  = 10
  consensus_reads_mode = "cluster_total"
  consensus_max_reads  = 100
  consensus_max_N      = 1

  // Higher quality threshold for vouchers.
  hq_quality_score = 20

  // Keep taxonomy filtering explicit in the profile.
  blast_filter_db = "db/targets_All_tagged_nr95"

  nonncbi_memtax = "db/COInr_2024Jun_metazoa_memtax1.txt|db/ITS2nr_2024Jun_viridiplantae_memtax2.txt"

  // Prefer filtered OTU evidence early and aggressively.
  otu_blast_filter_mode        = "observe"
  otu_blast_force_use_filtered = false

  // Remove weak unassigned signal sooner than environmental runs.
  otu_blast_unassigned_mode  = "observe"
  otu_unassigned_streak_mode = "observe"

  otu_size_streak_min_rounds = 1

  // Stronger cleanup for assignment-oriented vouchers.
  prune_unassigned_grace_rounds = 1
  prune_unassigned_keep_top     = 1

  // Mostly affects reporting/display, not core assignment.
  min_reads_sample = 10
}
