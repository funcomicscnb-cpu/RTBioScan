/*
 * -------------------------------------------------
 *  RTBioScan config: ITS2-only runs (standard MPold amplicon)
 * -------------------------------------------------
 * Use with: RTBioScan.sh -c conf/its2_only.config [other options]
 *
 * Overrides all pipe-separated multi-target defaults to ITS2-only values.
 * Standard amplicon: ~286–360 bp (MPold primers).
 * For LRv1 long amplicons (ITS1+ITS2, ~300–4200 bp) use its2_lr_only.config instead.
 */

params {
  targets                  = "ITS2"
  target_taxa              = "Viridiplantae"
  min_read_lengths         = "286"
  max_read_lengths         = "360"
  blast_db_specs           = "db/ITS2_nr99_lca"
  blast_id_family          = "92"
  blast_id_genus           = "95"
  blast_id_spec            = "98"
  nonncbi_memtax           = "db/ITS2nr_2024Jun_viridiplantae_memtax2.txt"
}
