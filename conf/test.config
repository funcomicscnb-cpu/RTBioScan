/*
 * -------------------------------------------------
 *  Nextflow config file for running tests
 * -------------------------------------------------
 * Defines bundled input files and everything required
 * to run a fast and simple test. Use as follows:
 *   nextflow run main.nf -profile test
 */

params {
  // True overrides (differ from nextflow.config defaults)
  otu_id = 98

  // Target seq databases (pipe-separated, same order as targets)
  blast_filter_db = "db/targets_All_tagged_nr95"
  blast_db_specs  = "db/COInr_nr99_lca|db/ITS2_nr99_lca"

  // No memtax files for test profile (empty entries preserve current behaviour)
  nonncbi_memtax = "|"
}
