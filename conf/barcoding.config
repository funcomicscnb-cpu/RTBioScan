/*
 * -------------------------------------------------
 *  Nextflow config file for running tests
 * -------------------------------------------------
 * Defines parameter overrides for barcoding runs.
 * Runs in batch mode (watch = false) by default. Use as follows:
 *   nextflow run main.nf -profile barcoding,docker
 */

params {
  // Default to batch semantics in barcoding profile; enable real-time watching with `--watch true`.
  watch = false

  // Higher quality threshold for barcoding.
  hq_quality_score = 20

  // Higher abundance requirement for barcoding.
  min_reads_sample = 10

  // Corrected ITS2 database for viridiplantae.
  nonncbi_memtax = "db/COInr_2024Jun_metazoa_memtax1.txt|db/ITS2nr_2024Jun_viridiplantae_memtax2.txt"
}
