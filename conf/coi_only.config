/*
 * -------------------------------------------------
 *  RTBioScan config: COI-only runs
 * -------------------------------------------------
 * Use with: RTBioScan.sh -c conf/coi_only.config [other options]
 *
 * Overrides all pipe-separated multi-target defaults to COI-only values.
 * Standard amplicon: ~350–532 bp (MLepF1/COIv1 style primers).
 */

params {
  targets                  = "COI"
  target_taxa              = "Metazoa"
  min_read_lengths         = "350"
  max_read_lengths         = "532"
  blast_db_specs           = "db/COInr_nr99_lca"
  blast_id_family          = "92"
  blast_id_genus           = "95"
  blast_id_spec            = "98"
  nonncbi_memtax           = "db/COInr_2024Jun_metazoa_memtax1.txt"
}
