/*
 * -------------------------------------------------
 *  RTBioScan config: ITS2-only runs (LRv1 long amplicon, ITS1+ITS2)
 * -------------------------------------------------
 * Use with: RTBioScan.sh -c conf/its2_lr_only.config [other options]
 *
 * LRv1 amplifies both ITS1 and ITS2 (~3–4 kb total). The ITS2 database
 * will align only the ITS2 portion of each read (~300 bp / ~10% of read).
 * Requires _QCOV lowered from 50 to 10 in main.nf (both occurrences) before
 * running, and reverted afterwards.
 */

params {
  targets                  = "ITS2"
  target_taxa              = "Viridiplantae"
  min_read_lengths         = "300"
  max_read_lengths         = "4200"
  blast_db_specs           = "db/ITS2_nr99_lca"
  blast_id_family          = "92"
  blast_id_genus           = "95"
  blast_id_spec            = "98"
  nonncbi_memtax           = "db/ITS2nr_2024Jun_viridiplantae_memtax2.txt"
}
